---
interface Props { texto: string; }
const { texto } = Astro.props;
---
<span class="logo">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect x="3" y="5" width="26" height="24" rx="4" fill="#fff" stroke="#000" stroke-width="2.5"/><path d="M3 9a4 4 0 0 1 4-4h18a4 4 0 0 1 4 4v3H3z" fill="#000"/><path d="M10 2.5v5M22 2.5v5" stroke="#000" stroke-width="2.5" stroke-linecap="round"/><path d="M10.5 20.2l3.6 3.6 7.6-8" fill="none" stroke="#1847C2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="logo-texto">{texto}</span>
</span>
<style>
  .logo { display:inline-flex; align-items:center; gap:10px; }
  .logo-texto { font-weight:700; font-size:1.3rem; letter-spacing:-.01em; color:var(--ink); }
</style>
