---
// Hueco para un bloque manual de AdSense. Desactivado hasta tener la cuenta aprobada:
// con ANUNCIOS = false no se pinta nada. Al activarlo, reserva altura fija para que el
// anuncio no mueva la página al cargar (CLS).
interface Props { lang: 'ca' | 'es'; alto?: number; }
const ANUNCIOS = false;
const { lang, alto = 280 } = Astro.props;
---
{ANUNCIOS && (
  <aside class="anuncio" style={`min-height:${alto}px`} aria-label={lang === 'ca' ? 'Publicitat' : 'Publicidad'}></aside>
)}
<style>
  .anuncio { margin:40px 0; }
</style>
