---
import { t, rutas } from '../i18n.js';
import { paginas, rutasLegales } from '../legal.js';
import Logo from '../components/Logo.astro';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
interface Props {
  lang: 'ca' | 'es';
  title: string;
  description: string;
  alternates: { ca: string; es: string };
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  jsonld?: object;
}
const { lang, title, description, alternates, noindex = false, breadcrumbs = [], jsonld } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = site + alternates[lang];
const s = t[lang];
const otro = lang === 'ca' ? 'es' : 'ca';
const bcLd = breadcrumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: site + b.url })),
} : null;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ca-ES" href={site + alternates.ca} />
  <link rel="alternate" hreflang="es-ES" href={site + alternates.es} />
  <link rel="alternate" hreflang="x-default" href={site + alternates.es} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={s.locale.replace('-', '_')} />
  {bcLd && <script type="application/ld+json" set:html={JSON.stringify(bcLd)} />}
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#ffffff" />
  <style is:global>
    :root {
      --paper:#ffffff; --ink:#000000; --ink-2:#3d3d3d; --ink-3:#6b6b6b; --line:#dcdcdc; --soft:#f5f5f3;
      --azul:#1847c2; --azul-hover:#123a9e; --azul-claro:#eef2fc; --rojo:#c8102e;
      --aviso:#5c4000; --aviso-bg:#fff5db;
      --ancho:1080px; --texto:68ch;
      color-scheme: light;
    }
    * { box-sizing:border-box; }
    html { -webkit-text-size-adjust:100%; }
    body { margin:0; background:var(--paper); color:var(--ink); font:17px/1.6 "Atkinson Hyperlegible Next", system-ui, sans-serif; font-variant-numeric:tabular-nums; }
    a { color:var(--azul); text-underline-offset:.18em; }
    a:hover { color:var(--azul-hover); }
    :focus-visible { outline:3px solid var(--azul); outline-offset:2px; border-radius:4px; }
    .envoltorio { max-width:var(--ancho); margin:0 auto; padding:0 20px; }
    h1 { font-size:clamp(2rem, 1.2rem + 3.2vw, 3.1rem); line-height:1.08; letter-spacing:-.025em; margin:0 0 14px; max-width:20ch; }
    h2 { font-size:1.6rem; line-height:1.2; letter-spacing:-.015em; margin:56px 0 12px; }
    h3 { font-size:1.15rem; line-height:1.3; margin:24px 0 6px; }
    p, li { max-width:var(--texto); }
    .lead { font-size:1.15rem; color:var(--ink-2); margin:0 0 24px; }
    .migas { font-size:.9rem; color:var(--ink-3); margin:0 0 16px; }
    .migas a { color:var(--ink-3); }
    table { width:100%; border-collapse:collapse; margin:8px 0; }
    th, td { text-align:left; padding:10px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
    th { font-size:.9rem; color:var(--ink-3); font-weight:700; border-bottom:2px solid var(--ink); }
    .aviso { background:var(--aviso-bg); color:var(--aviso); padding:12px 14px; border-radius:8px; margin:12px 0; }
    .nota { font-size:.9rem; color:var(--ink-3); }
    .sitio-cab { border-bottom:1px solid var(--line); }
    .sitio-cab .envoltorio { display:flex; justify-content:space-between; align-items:center; gap:12px 24px; padding-top:14px; padding-bottom:14px; flex-wrap:wrap; }
    .sitio-cab .marca { text-decoration:none; }
    .sitio-cab nav { display:flex; gap:6px 22px; flex-wrap:wrap; font-size:.98rem; }
    .sitio-cab nav a { color:var(--ink); text-decoration:none; font-weight:700; }
    .sitio-cab nav a:hover { text-decoration:underline; }
    .sitio-cab .marca { margin-right:auto; }
    .sitio-cab .idioma { color:var(--ink-2); text-decoration:none; }
    .sitio-cab .idioma:hover { text-decoration:underline; }
    main.envoltorio { padding-top:32px; padding-bottom:64px; }
    .sitio-pie { background:var(--soft); border-top:1px solid var(--line); font-size:.92rem; color:var(--ink-2); }
    .sitio-pie .envoltorio { display:grid; grid-template-columns:2fr 1fr 1fr; gap:24px 40px; padding-top:40px; padding-bottom:40px; }
    .sitio-pie h2 { font-size:.95rem; margin:0 0 10px; letter-spacing:0; }
    .sitio-pie ul { list-style:none; margin:0; padding:0; display:grid; gap:6px; }
    .sitio-pie a { color:var(--ink-2); }
    .sitio-pie p { margin:12px 0 0; }
    @media (max-width: 720px) {
      body { font-size:16.5px; }
      .sitio-pie .envoltorio { grid-template-columns:1fr; }
      h2 { margin-top:44px; }
      .sitio-cab nav { gap:4px 16px; font-size:.92rem; order:3; width:100%; }
      .logo-texto { font-size:1.15rem; }
    }
    @media (prefers-reduced-motion: reduce) { * { animation:none !important; transition:none !important; scroll-behavior:auto !important; } }
  </style>
</head>
<body>
  <header class="sitio-cab">
    <div class="envoltorio">
      <a class="marca" href={rutas.inicio[lang]} aria-label={`${s.marca}, ${lang === 'ca' ? 'inici' : 'inicio'}`}><Logo texto={s.marca} /></a>
      <nav aria-label={lang === 'ca' ? 'Principal' : 'Principal'}>
        <a href={rutas.calculadora[lang]}>Calculadora</a>
        <a href={rutas.calendario[lang](2026)}>{lang === 'ca' ? 'Festius 2026' : 'Festivos 2026'}</a>
        <a href={rutas.calendario[lang](2027)}>{lang === 'ca' ? 'Festius 2027' : 'Festivos 2027'}</a>
      </nav>
      <a class="idioma" href={alternates[otro]} hreflang={otro} lang={otro}>{s.otroIdioma}</a>
    </div>
  </header>
  <main class="envoltorio">
    {breadcrumbs.length > 1 && (
      <nav class="migas" aria-label={lang === 'ca' ? 'Ruta de navegació' : 'Ruta de navegación'}>
        {breadcrumbs.map((b, i) => (<>{i > 0 && ' › '}{i < breadcrumbs.length - 1 ? <a href={b.url}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</>))}
      </nav>
    )}
    <slot />
  </main>
  <footer class="sitio-pie">
    <div class="envoltorio">
      <div>
        <Logo texto={s.marca} />
        <p>{lang === 'ca'
          ? 'Calculadora gratuïta de terminis administratius amb els festius oficials de cada municipi de Catalunya, segons el DOGC i el BOE.'
          : 'Calculadora gratuita de plazos administrativos con los festivos oficiales de cada municipio de Cataluña, según el DOGC y el BOE.'}</p>
        <p>{lang === 'ca' ? 'Eina orientativa: no substitueix l’assessorament professional.' : 'Herramienta orientativa: no sustituye el asesoramiento profesional.'} {lang === 'ca' ? 'Un projecte de' : 'Un proyecto de'} <a href="https://rankova.es">Rankova</a>.</p>
      </div>
      <nav aria-label={lang === 'ca' ? 'Eines' : 'Herramientas'}>
        <h2>{lang === 'ca' ? 'Eines' : 'Herramientas'}</h2>
        <ul>
          <li><a href={rutas.calculadora[lang]}>{s.calculadora}</a></li>
          <li><a href={rutas.calendario[lang](2026)}>{lang === 'ca' ? 'Festius 2026' : 'Festivos 2026'}</a></li>
          <li><a href={rutas.calendario[lang](2027)}>{lang === 'ca' ? 'Festius 2027' : 'Festivos 2027'}</a></li>
          <li><a href={rutas.metodologia[lang]}>{s.metodologia}</a></li>
        </ul>
      </nav>
      <nav aria-label={lang === 'ca' ? 'Informació legal' : 'Información legal'}>
        <h2>{lang === 'ca' ? 'Informació legal' : 'Información legal'}</h2>
        <ul>{Object.entries(rutasLegales).map(([clave, r]) => <li><a href={r[lang]}>{paginas[clave as keyof typeof paginas][lang].titulo}</a></li>)}</ul>
      </nav>
    </div>
  </footer>
</body>
</html>
